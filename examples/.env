CONCURRENT_REQUESTS=2
DEFAULT_REQUEST_HEADERS_FILE=headers.json
ROTATING_PROXY_LIST_PATH=proxies.txt

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=user
S3_SECRET_KEY=pass-pass
S3_REGION=us-east-1
S3_BUCKET=html
S3_PREFIX=pages

MONGO_URI=mongodb://user:pass@mongo:27017
MONGO_DATABASE=kolesa
MONGO_COLLECTION=cars
MONGO_BATCH_SIZE=10

RABBITMQ_URL=amqp://admin:admin@rabbit:5672/
RABBITMQ_EXCHANGE=kolesa
RABBITMQ_EX_TYPE=direct
RABBITMQ_ROUTING_KEY=kolesa
RABBITMQ_QUEUE=cars
RABBITMQ_BUFFER=10

LIST_GET_PARAMS_FILE=params.json
